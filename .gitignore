# ============================================================
# Build / Packaging
# ============================================================

build/
dist/
*.egg-info/
.eggs/
wheels/

# PyInstaller generated temporary files
# NOTE:
# Keep *.spec files under version control because the spec file
# should be part of the reproducible packaging configuration.
__pyinstaller__/

# Installer output
installer-output/
release/


# ============================================================
# Application runtime data
# ============================================================

# Local SQLite runtime databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Application runtime data directory
runtime/
runtime-data/

# Temporary application files
tmp/
temp/

# Logs
logs/
*.log


# ============================================================
# Local configuration / secrets
# ============================================================

.env
.env.*
!.env.example

config.local.*
settings.local.*

*.secret
*.secrets


# ============================================================
# PySide6 / Qt generated files
# ============================================================

# Generated Python files from Qt Designer .ui files
ui_*.py

# Generated Python files from Qt resource files
*_rc.py

# Qt / QML caches
.qmlcache/
qmlcache/

# NOTE:
# Do NOT ignore *.ui or *.qrc.
# They are source files and should be committed.


